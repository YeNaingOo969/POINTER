# Copy to .env and fill in your own values. Never commit .env.

# OpenRouteService — optional preferred routing provider (free key: https://account.heigit.org → Tokens)
# A VITE_ key is inlined into the public JS bundle, so anyone can read it: treat it as public.
# Leave it empty (the default) and routes still work through the keyless OSRM fallback. A dashed
# straight-line preview appears only if both routing services are unreachable.
VITE_ORS_API_KEY=

