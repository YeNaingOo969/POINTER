# Copy to .env and fill in your own values. Never commit .env.

# OpenRouteService — optional preferred routing provider (free key: https://account.heigit.org → Tokens)
# VITE_ prefix makes it readable by the browser, so use a free, restricted key only.
# Leave empty: routes still work through the keyless OSRM fallback. A dashed straight-line preview
# appears only if both routing services are unreachable.
VITE_ORS_API_KEY=

