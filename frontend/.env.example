# Copy to .env and fill in your own values. Never commit .env.

# OpenRouteService — in-web route lines (free key: sign up at https://account.heigit.org, then Tokens)
# VITE_ prefix makes it readable by the browser, so use a free, restricted key only.
# Leave empty to get straight-line route previews instead of road routes.
VITE_ORS_API_KEY=

